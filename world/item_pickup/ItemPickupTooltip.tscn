[gd_scene format=3 uid="uid://b1uj7j07x8xru"]

[sub_resource type="GDScript" id="GDScript_v4gtf"]
script/source = "extends ToolTipBase

@export var LabelName: Label
@export var LabelDescription: Label

func setup(_source: Node):
	var item_pickup = _source as ItemPickup
	var item_data = item_pickup.item_data
	
	LabelName.text = item_data.name
	LabelDescription.text = \"Description maneira\"
"

